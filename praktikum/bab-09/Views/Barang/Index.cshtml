@model IEnumerable<Barang>
@{
    ViewData["Title"] = "Daftar Barang";
}
<h1>Daftar Barang</h1>
<p><a asp-action="Create">Tambah barang</a></p>
<table>
    <thead><tr><th>Kode</th><th>Nama</th><th>Stok</th><th>Kategori</th></tr></thead>
    <tbody>
    @foreach (var barang in Model)
    {
        <tr>
            <td>@barang.KodeBarang</td>
            <td>@barang.NamaBarang</td>
            <td>@barang.JumlahStok</td>
            <td>@barang.Kategori</td>
        </tr>
    }
    </tbody>
</table>
